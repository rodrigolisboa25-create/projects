# Configuracao local do NexxusDoc. Somente os valores deste arquivo sao usados:
# variaveis de ambiente do Windows (ex.: N8N_CHAT_URL de outros sistemas) sao ignoradas.

# Production Webhook URL do workflow n8n do NexxusDoc (exige VPN corporativa).
NEXUS_N8N_URL=https://n8n.example.com/webhook/normas-procedimentos-generate

# E-mail UPN da sua sessao Windows. Sera bootstrapado como administrador master.
MASTER_ADMIN_EMAIL=admin@example.com

# Pasta compartilhada com as subpastas levantamentos/, entrevistas/ e documentos_gerados/.
# Preenchida automaticamente pelo instalador com a pasta sincronizada pelo Google Drive.
SHARED_PROJECT_ROOT=

# Segredo local para assinatura da sessao web (gerado pelo instalador).
SESSION_SECRET=

# Porta local do NexxusDoc. Nao use 8765: ela pertence ao Estoque Contabil.
NEXUS_PORT=8790

# Minutos sem uso (navegador fechado) ate o servidor local encerrar sozinho.
NEXUS_IDLE_MINUTES=30
