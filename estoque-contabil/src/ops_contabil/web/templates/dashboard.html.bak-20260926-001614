  <main class="main">
    <header class="top"><div class="top-left"><button class="btn sidebar-toggle" id="sidebar-toggle" type="button" aria-expanded="true" aria-label="Recolher menu lateral" title="Recolher ou expandir menu">☰</button><div class="crumb">Fechamento / <b id="section-name">Visão e relatórios</b></div></div><div class="top-actions"><select id="global-period" aria-label="Competência compilada"><option value="">Carregando competências…</option></select><button class="btn" id="refresh">Atualizar</button><button class="btn primary" data-open-view="sap">Extrair SAP</button><div class="user-chip"><div><b id="signed-user">—</b><small id="signed-role">—</small></div><button class="btn logout-btn" id="logout" type="button">Sair</button></div></div></header>
    <div class="content">
      <section class="panel" data-panel="overview">
        <div class="heading"><div><h1>Posição contábil do estoque - Fisia</h1><p id="overview-sub">Indicadores calculados diretamente da Base de estoque</p></div><div class="heading-actions"><button class="btn share-html-btn" id="share-html" type="button" data-admin-only>Share Link</button><span class="status" id="data-status">Carregando</span></div></div>
        <div class="kpis">
          <div class="card kpi"><span class="kpi-icon" aria-hidden="true">💰</span><div><div class="label">Valor fiscal</div><div class="value" id="k-fiscal">—</div><div class="sub">Vlr Tot Fisc</div></div></div>
          <div class="card kpi"><span class="kpi-icon" aria-hidden="true">📦</span><div><div class="label">Utilização livre</div><div class="value" id="k-qty">—</div><div class="sub">unidades disponíveis</div></div></div>
          <div class="card kpi"><span class="kpi-icon" aria-hidden="true">🧾</span><div><div class="label">Materiais</div><div class="value" id="k-materials">—</div><div class="sub">SKUs distintos</div></div></div>
          <div class="card kpi"><span class="kpi-icon" aria-hidden="true">📊</span><div><div class="label">Média PMM</div><div class="value" id="k-pmm">—</div><div class="sub" id="k-pmm-sub">Vlr Tot Fisc ÷ quantidade livre</div></div></div>
          <div class="card kpi"><span class="kpi-icon" aria-hidden="true">🌎</span><div><div class="label">Cobertura All Brazil</div><div class="value" id="k-coverage">—</div><div class="sub">atributo Division preenchido</div></div></div>
        </div>
        <div class="dashboard-grid">
          <div class="card section span6"><div class="head"><h2>Lifecycle × Aging</h2><small>valor fiscal por faixa</small></div><div id="chart-lifecycle-aging"></div></div>
          <div class="card section span6"><div class="head"><h2>Aging for Season</h2><small>ano × season</small></div><div class="matrix-wrap" id="matrix-aging-season"></div></div>
          <div class="card section span6"><div class="head"><h2>Division Description</h2><small>quantidade livre · valor fiscal</small></div><div id="chart-division"></div></div>
          <div class="card section span6"><div class="head"><h2>Local de estoque</h2><small>valor fiscal &middot; quantidade livre</small></div><div class="bars" id="chart-locations"></div></div>
          <div class="card section span6"><div class="head"><h2>Valor por centro</h2><small>concentração</small></div><div class="bars" id="chart-plants"></div></div>
          <div class="card section span6"><div class="head"><h2>Origem do material</h2><small>valor fiscal</small></div><div class="bars" id="chart-origins"></div></div>
          <div class="card section span6"><div class="head"><h2>Evolução da posição de estoque</h2><small>valor fiscal e quantidade · competências compiladas</small></div><div class="trend-chart" id="chart-trend"></div></div>
          <div class="card section span6"><div class="head"><h2>Variação por categoria</h2><small id="variance-period-label">competência atual × anterior</small></div><div class="variance-list" id="chart-division-variance"></div></div>
          <div class="card section span6"><div class="head"><h2>PMM analítico</h2><label class="chart-filter" for="pmm-dimension"><span>Visualizar por</span><select id="pmm-dimension"><option value="period">Período</option><option value="division">Division Description</option><option value="plant">Centro</option><option value="location">Local de estoque</option><option value="season">Season</option></select></label></div><div class="pareto-chart" id="chart-pmm-pareto"></div></div>
          <div class="card section span6"><div class="head"><h2>Composição do custo fiscal</h2><small>FOB · imposto de importação · outros custos</small></div><div class="pie3d-chart" id="chart-cost-composition"></div></div>
          <div class="card section span12"><div class="head"><div><h2>Dispersão do estoque livre</h2><small>valor fiscal × quantidade livre · tamanho do ponto representa o volume de registros</small></div><label class="chart-filter" for="stock-dimension"><span>Visualizar por</span><select id="stock-dimension"><option value="period">Período</option><option value="division">Division Description</option><option value="plant">Centro</option><option value="location">Local de estoque</option><option value="season">Season</option></select></label></div><div class="scatter-chart" id="chart-stock-scatter"></div></div>
        </div>
      </section>

      <section class="panel" data-panel="inventory">
        <div class="inventory-loading-overlay" id="inventory-loading-overlay" hidden role="status" aria-live="polite" aria-busy="true"><div class="inventory-loading-card" id="inventory-loading-card"><div class="inventory-loading-spinner"></div><div class="inventory-loading-percent" id="inventory-loading-percent">0%</div><div class="inventory-progress-track"><div class="inventory-progress-fill" id="inventory-progress-fill"></div></div><b id="inventory-loading-title">Processando Base de Estoque</b><small id="inventory-loading-detail">Aguarde a conclusão para continuar.</small><span class="inventory-loading-stage" id="inventory-loading-stage"></span></div></div>
        <div class="heading"><div><h1>Base de Estoque — Planilha online</h1><p>ZMM119 carregada por contrato posicional A:R; demais campos são calculados e enriquecidos por MB59, pelo último All Brazil válido do mês e Mapping.</p></div><div class="inventory-statuses"><span class="status mb59-pending" id="mb59-inventory-status" title="Situação da Base GR na competência">MB59: verificando</span><span class="status" id="grid-count">—</span></div></div>
        <div class="card">
          <div class="toolbar"><input class="search" id="grid-search" placeholder="Buscar material, descrição, centro, NCM, aging..."><select id="page-size"><option>25</option><option selected>50</option><option>100</option><option>200</option></select><button class="btn" id="search-btn">Pesquisar</button><div class="group-controls" aria-label="Agrupar colunas"><button class="btn group-toggle" data-toggle-band="identification" data-band="identification" aria-pressed="true">Identificação</button><button class="btn group-toggle" data-toggle-band="sap" data-band="sap" aria-pressed="true">SAP ZMM119</button><button class="btn group-toggle" data-toggle-band="enrichment" data-band="enrichment" aria-pressed="true">Cálculos e enriquecimento</button></div><span class="spacer"></span><button class="btn join-pending-btn" id="pending-joins-toggle" type="button" aria-pressed="false">Somente pendências de joins</button><button class="btn" id="clear-column-filters">Limpar filtros</button><button class="btn" id="download-grid" type="button">Baixar XLSX</button><button class="btn" id="reprocess-joins" type="button" title="Reaplica All Brazil, PASSO A PASSO e Mapping sem reler a ZMM119">Reprocessar joins</button><button class="btn" id="reload-grid">Recarregar base</button></div>
          <div class="grid-wrap"><table id="inventory-table"><thead><tr class="group-row" id="inventory-groups"></tr><tr class="column-row" id="inventory-head"></tr><tr class="filter-row" id="inventory-filters"></tr></thead><tbody id="inventory-body"><tr><td class="loading">Carregando dados…</td></tr></tbody></table></div>
          <div class="grid-status"><span id="grid-info">—</span><div class="pager"><button class="btn" id="prev-page">Anterior</button><button class="btn" id="next-page">Próxima</button></div></div>
