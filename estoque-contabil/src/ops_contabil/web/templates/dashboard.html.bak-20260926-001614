      </section>

      <section class="panel" data-panel="governance">
        <div class="heading"><div><h1>Controles e auditoria</h1><p>Contrato de dados e rastreabilidade</p></div><span class="status" id="governance-status">Verificando</span></div>
        <div class="audit-grid">
