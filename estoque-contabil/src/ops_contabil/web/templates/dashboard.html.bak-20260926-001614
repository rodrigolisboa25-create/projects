<script>
const state={period:'',page:1,pageSize:50,q:'',sort:'source_row',direction:'asc',columns:[],pages:1,filters:{},pendingJoins:false,collapsed:new Set(),settingsLoaded:false,authUser:null,csrfToken:'',loadedViews:new Set(),periods:[],pmmDimension:localStorage.getItem('opsPmmDimension')||'period',stockDimension:localStorage.getItem('opsStockDimension')||'period',currentSummary:null};
const labels={overview:'Visão e relatórios',inventory:'Base de estoque',sap:'Extrações SAP','all-brazil':'Bases All Brazil',mapping:'Mapping',governance:'Controles e auditoria',health:'Health Center',agent:'Optimus',settings:'Configurações'};
const money=new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL',maximumFractionDigits:2}),num=new Intl.NumberFormat('pt-BR',{maximumFractionDigits:2});
const detailGroups=[
  {label:'IDENTIFICAÇÃO',band:'identification',tone:'identification',keys:['center_material_key','operation_status']},
  {label:'SAP ZMM119',band:'sap',tone:'sap',keys:['company','plant','material','material_description','base_unit','ncm','unrestricted_quantity','blocked_quantity','average_company_cost','fiscal_cost','total','icms_st_amount','ipi_amount','inventory_type','company_total_amount','fiscal_total_amount','average_commercial_cost','commercial_total_amount']},
  {label:'FÓRMULA',band:'enrichment',tone:'formula',keys:['company_unit_cost','style_color','style','fiscal_unit_cost']},
  {label:'ALLBRAZIL',band:'enrichment',tone:'all-brazil',keys:['division_description','material_origin']},
  {label:'PASSO - PASSO',band:'enrichment',tone:'step',keys:['product_offer_end_date']},
  {label:'FÓRMULA',band:'enrichment',tone:'formula',keys:['aging_days','aging_bucket']},
  {label:'ALLBRAZIL',band:'enrichment',tone:'all-brazil',keys:['lifecycle','lifecycle_description']},
  {label:'FÓRMULA',band:'enrichment',tone:'formula',keys:['location_group','fob_amount','import_tax_amount','other_costs_amount','season_year']},
  {label:'PASSO - PASSO',band:'enrichment',tone:'step',keys:['season','year']}
];
const keyBand=new Map(detailGroups.flatMap(group=>group.keys.map(key=>[key,group.band])));
const keyTone=new Map(detailGroups.flatMap(group=>group.keys.map(key=>[key,group.tone])));
function toast(message){const el=document.getElementById('toast');el.textContent=message;el.classList.add('show');setTimeout(()=>el.classList.remove('show'),3500)}
function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
async function api(url,options={}){options.credentials='same-origin';options.headers={...(options.headers||{})};if(state.csrfToken&&['POST','PUT','PATCH','DELETE'].includes(String(options.method||'GET').toUpperCase()))options.headers['X-CSRF-Token']=state.csrfToken;const response=await fetch(url,options);let body;try{body=await response.json()}catch{body={detail:'Resposta inválida do servidor'}}if(response.status===401&&state.authUser){state.authUser=null;document.body.classList.remove('authenticated');document.getElementById('login-message').textContent='Sua sessão expirou. Entre novamente.'}if(!response.ok)throw new Error(body.detail||'Erro na operação');return body}
function canAccess(view){return Boolean(state.authUser&&(state.authUser.role==='admin'||state.authUser.pages.includes(view)))}
function firstAllowedView(){return state.authUser?.role==='admin'?'overview':(state.authUser?.pages?.[0]||'overview')}
function viewCacheKey(view){return ['overview','inventory','governance','health'].includes(view)?`${view}:${state.period}`:view}
async function loadViewData(view,{force=false,preload=false}={}){const key=viewCacheKey(view);if(!force&&state.loadedViews.has(key))return true;let result=true;if(view==='overview')result=await Promise.all([loadSummary(),loadAllBrazil()]);else if(view==='inventory')result=await Promise.all([loadInventory({blocking:!preload}),loadMb59Status()]);else if(view==='sap')result=await loadJobs();else if(view==='all-brazil')result=await loadAllBrazilCatalog(force);else if(view==='mapping')result=await loadMappings(force);else if(view==='governance')result=await loadGovernance();else if(view==='health')result=await loadHealthCenter();else if(view==='settings')result=await loadSettings(force);state.loadedViews.add(key);return result}
let healthPollTimer=null;function configureHealthPolling(view){if(healthPollTimer){clearInterval(healthPollTimer);healthPollTimer=null}if(view!=='health')return;healthPollTimer=setInterval(()=>{if(document.visibilityState==='visible'&&document.querySelector('[data-panel="health"]')?.classList.contains('active'))loadViewData('health',{force:true})},15000)}
function activate(view,push=true,load=true){if(!labels[view]||!canAccess(view))view=firstAllowedView();document.querySelectorAll('[data-view]').forEach(a=>a.classList.toggle('active',a.dataset.view===view));document.querySelectorAll('[data-panel]').forEach(p=>p.classList.toggle('active',p.dataset.panel===view));document.getElementById('section-name').textContent=labels[view];configureHealthPolling(view);if(push&&location.hash!=='#'+view)history.pushState(null,'','#'+view);if(load)loadViewData(view);return view}
document.querySelectorAll('[data-view]').forEach(a=>a.onclick=e=>{e.preventDefault();activate(a.dataset.view)});document.querySelectorAll('[data-open-view]').forEach(b=>b.onclick=()=>activate(b.dataset.openView));window.onhashchange=()=>activate(location.hash.slice(1),false);
const appLayout=document.getElementById('app-layout'),sidebarToggle=document.getElementById('sidebar-toggle');
function setSidebarCollapsed(collapsed){appLayout.classList.toggle('sidebar-collapsed',collapsed);sidebarToggle.setAttribute('aria-expanded',String(!collapsed));sidebarToggle.setAttribute('aria-label',collapsed?'Expandir menu lateral':'Recolher menu lateral');localStorage.setItem('opsSidebarCollapsed',collapsed?'1':'0')}
sidebarToggle.onclick=()=>setSidebarCollapsed(!appLayout.classList.contains('sidebar-collapsed'));setSidebarCollapsed(localStorage.getItem('opsSidebarCollapsed')==='1');

function setLoginMessage(message,isError=true){const el=document.getElementById('login-message');el.textContent=message||'';el.style.color=isError?'#9d2f2f':'#315f43'}
function applyUserAccess(user){
  state.authUser=user;const admin=user.role==='admin';
  const installerCard=document.getElementById('installer-card');if(installerCard)installerCard.hidden=!admin;
  document.querySelectorAll('[data-admin-only]').forEach(element=>element.hidden=!admin);
  document.querySelectorAll('[data-view]').forEach(link=>{link.hidden=!(admin||user.pages.includes(link.dataset.view))});
  document.querySelectorAll('.nav .group').forEach(group=>{let next=group.nextElementSibling,visible=false;while(next&&!next.classList.contains('group')){if(next.matches('[data-view]')&&!next.hidden)visible=true;next=next.nextElementSibling}group.hidden=!visible});
  document.querySelectorAll('[data-open-view]').forEach(button=>button.hidden=!(admin||user.pages.includes(button.dataset.openView)));
  document.getElementById('signed-user').textContent=user.email;document.getElementById('signed-role').textContent=admin?'Administrador':'Usuário';
}
document.getElementById('login-form').onsubmit=async event=>{event.preventDefault();const email=document.getElementById('login-email').value.trim().toLowerCase();if(!/@(gruposbf|fisia)\.com\.br$/.test(email)){setLoginMessage('Use um e-mail @gruposbf.com.br ou @fisia.com.br.');return}setLoginMessage('Confirmando a identidade corporativa do Windows…',false);try{const result=await api('/api/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email})});applyUserAccess(result.user);document.body.classList.add('authenticated');await startSystem()}catch(e){setLoginMessage(e.message)}};
document.getElementById('logout').onclick=async()=>{try{await api('/api/auth/logout',{method:'POST'});}finally{location.hash='';location.reload()}};

const chartTooltip=document.getElementById('chart-tooltip');
function showChartTooltip(target,event){chartTooltip.textContent=target.dataset.tip;chartTooltip.classList.add('show');if(event){chartTooltip.style.left=Math.min(event.clientX+12,window.innerWidth-290)+'px';chartTooltip.style.top=Math.min(event.clientY+12,window.innerHeight-70)+'px'}}
document.addEventListener('mousemove',event=>{const target=event.target.closest('[data-tip]');if(target)showChartTooltip(target,event)});
document.addEventListener('mouseover',event=>{const target=event.target.closest('[data-tip]');if(target)showChartTooltip(target,event)});
document.addEventListener('mouseout',event=>{if(event.target.closest('[data-tip]'))chartTooltip.classList.remove('show')});
document.addEventListener('focusin',event=>{const target=event.target.closest('[data-tip]');if(target){const rect=target.getBoundingClientRect();showChartTooltip(target,{clientX:rect.right-10,clientY:rect.top})}});
document.addEventListener('focusout',event=>{if(event.target.closest('[data-tip]'))chartTooltip.classList.remove('show')});
const compact=new Intl.NumberFormat('pt-BR',{notation:'compact',maximumFractionDigits:1});
function chart(id,items){const el=document.getElementById(id),max=Math.max(1,...items.map(x=>Math.abs(x.value)));el.innerHTML=items.length?items.map(x=>{const tip=`${x.label}: ${money.format(x.value)} · ${num.format(x.rows||0)} registros`;return `<div class="bar" tabindex="0" data-tip="${esc(tip)}"><span class="bar-label">${esc(x.label)}</span><div class="track"><div class="fill" style="width:${Math.max(2,Math.abs(x.value)/max*100)}%"></div></div><b>${money.format(x.value)}</b></div>`}).join(''):'<span class="sub">Sem dados para a competência.</span>'}
function locationChart(id,items){const el=document.getElementById(id),max=Math.max(1,...items.map(x=>Math.abs(x.value||0)));el.innerHTML=items.length?items.map(x=>{const tip=`${x.label}: ${money.format(x.value||0)} · ${num.format(x.quantity||0)} unidades livres`;return `<div class="location-bar" tabindex="0" data-tip="${esc(tip)}"><span class="bar-label">${esc(x.label)}</span><div class="track"><div class="fill" style="width:${Math.max(2,Math.abs(x.value||0)/max*100)}%"></div></div><span class="location-meta">${money.format(x.value||0)} <span class="qty">(${num.format(x.quantity||0)} un)</span></span></div>`}).join(''):'<span class="sub">Sem dados para a competência.</span>'}
function matrixChart(id,matrix){const el=document.getElementById(id),rows=matrix?.rows||[],cols=matrix?.columns||[],values=matrix?.values||[];if(!rows.length||!cols.length){el.innerHTML='<span class="sub">Sem dados para a competência.</span>';return}const flat=values.flat().map(Number),max=Math.max(1,...flat.map(Math.abs));el.innerHTML=`<table class="matrix"><thead><tr><th></th>${cols.map(c=>`<th>${esc(c)}</th>`).join('')}</tr></thead><tbody>${rows.map((r,ri)=>`<tr><th>${esc(r)}</th>${cols.map((c,ci)=>{const v=Number(values?.[ri]?.[ci]||0),alpha=.08+.46*Math.abs(v)/max,tip=`${r} · ${c}: ${money.format(v)}`;return `<td tabindex="0" data-tip="${esc(tip)}" style="background:rgba(181,255,32,${alpha.toFixed(3)})">${money.format(v)}</td>`}).join('')}</tr>`).join('')}</tbody></table>`}
