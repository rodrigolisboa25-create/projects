async function waitInventoryReload(jobId,title='Recarregando Base de Estoque'){for(;;){const job=await api(`/api/inventory/import/jobs/${jobId}`);updateInventoryLoading(title,job.message||'Processando a competência.',Number(job.progress||0),inventoryReloadStageNames[job.status]||job.status);if(job.status==='COMPLETED')return job;if(job.status==='FAILED')throw new Error(job.message||'Falha no processamento da Base de Estoque.');await sleep(750)}}
document.getElementById('reload-grid').onclick=async()=>{const button=document.getElementById('reload-grid');button.disabled=true;showInventoryLoading('Recarregando Base de Estoque','Preparando a recarga da competência.',2,'Iniciando');try{const started=await api('/api/inventory/import/start',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({period:state.period,force:true})});const job=await waitInventoryReload(started.job_id);const rows=job.result?.rows||0;const discarded=job.result?.discarded_company_rows||0;toast(`${rows} linhas atualizadas da Empresa 7170${discarded?` · ${discarded} de outras empresas descartadas`:''}`);updateInventoryLoading('Atualizando a tela','Base processada. Atualizando indicadores e grade.',100,'Concluído');await Promise.all([loadSummary(),loadInventory({blocking:false}),loadMb59Status()])}catch(e){toast(e.message)}finally{button.disabled=false;hideInventoryLoading()}};

let sapPollTimer=null;
function ensureSapPolling(){if(sapPollTimer)return;sapPollTimer=setInterval(async()=>{const jobs=await loadJobs();const active=jobs.some(job=>['QUEUED','STARTING','CONNECTION_SELECTED','OPENING_SAP','OPENING_CONNECTION','WAITING_FOR_LOGIN','RUNNING','OPENING_TRANSACTION','RUNNING_REPORT','ARCHIVING','EXPORTING','EXPORTING_FILE','FILE_READY','IMPORTING','ENRICHING','CANCEL_REQUESTED'].includes(job.status));if(!active){clearInterval(sapPollTimer);sapPollTimer=null}},1000)}
async function submitSap(form,transaction){const data=Object.fromEntries(new FormData(form));const body={transaction,period:data.period,connection_name:data.connection_name||'',variant:data.variant||'BASE GR',date_from:data.date_from||null,date_to:data.date_to||null,as_of:data.as_of||null,fisia_only:data.fisia_only==='on'};try{await api('/api/sap/run',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});toast(`${transaction}: abrindo SAP e preparando a extração`);await loadJobs();ensureSapPolling()}catch(e){toast(e.message)}}
document.getElementById('z-form').onsubmit=e=>{e.preventDefault();submitSap(e.target,'ZMM119')};document.getElementById('m-form').onsubmit=e=>{e.preventDefault();submitSap(e.target,'MB59')};
async function loadJobs(){try{const jobs=await api('/api/sap/jobs'),names={QUEUED:'Na fila',STARTING:'Preparando',CONNECTION_SELECTED:'Conexão localizada',OPENING_SAP:'Abrindo SAP',OPENING_CONNECTION:'Abrindo conexão exclusiva',WAITING_FOR_LOGIN:'Aguardando SSO',RUNNING:'Executando',OPENING_TRANSACTION:'Abrindo transação',RUNNING_REPORT:'Processando relatório',ARCHIVING:'Preservando anterior',EXPORTING:'Enviando comandos',EXPORTING_FILE:'Gerando XLSX',FILE_READY:'Arquivo localizado',IMPORTING:'Importando base',ENRICHING:'Aplicando enriquecimentos',CANCEL_REQUESTED:'Cancelando',CANCELLED:'Cancelado',COMPLETED:'Concluído',ACTION_REQUIRED:'Requer ação',FAILED:'Falhou'},container=document.getElementById('jobs-list'),terminal=['COMPLETED','FAILED','ACTION_REQUIRED','CANCELLED'];if(!jobs.length){container.innerHTML='<div class="sap-empty">Nenhuma extração em andamento nesta sessão.</div>';return []}container.innerHTML=jobs.map(j=>{const active=!terminal.includes(j.status),started=j.started_at?new Date(j.started_at).getTime():Date.now(),elapsed=Math.max(0,(Date.now()-started)/1000);let progress=Number(j.progress||0);if(active&&j.status==='EXPORTING_FILE')progress=Math.min(85,progress+Math.floor(elapsed/8));progress=Math.max(0,Math.min(100,progress));const stateClass=j.status==='COMPLETED'?'completed':j.status==='CANCELLED'?'cancelled':['FAILED','ACTION_REQUIRED'].includes(j.status)?'failed':'';const cancelButton=active?`<button class="btn sap-cancel" type="button" data-cancel-sap="${esc(j.job_id||'')}">Cancelar</button>`:'';return `<div class="sap-monitor ${stateClass}" data-sap-job="${esc(j.job_id||'')}"><div class="sap-monitor-top"><div class="sap-ticker"><span class="live-dot"></span><b>${esc(j.transaction)}</b><span>${esc(j.period)}</span></div><div class="sap-monitor-actions"><span class="sap-percent">${progress}%</span>${cancelButton}</div></div><div class="sap-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${progress}" aria-label="Andamento estimado da extração ${esc(j.transaction)}"><div class="sap-progress-fill" style="width:${progress}%"></div></div><div class="sap-job-meta"><span class="badge ${['FAILED','ACTION_REQUIRED','WAITING_FOR_LOGIN','CANCEL_REQUESTED'].includes(j.status)?'warn':''}">${esc(names[j.status]||j.status)}</span><span class="sap-message">${esc(j.message||'Preparando a execução no SAP GUI')}</span><span class="sap-clock">${j.duration_seconds!=null?esc(j.duration_seconds+' s'):esc(j.created_at||'')}</span></div></div>`}).join('');return jobs}catch(e){toast(e.message);return []}}
document.getElementById('refresh-jobs').onclick=loadJobs;
document.getElementById('jobs-list').onclick=async event=>{const button=event.target.closest('[data-cancel-sap]');if(!button)return;button.disabled=true;try{await api(`/api/sap/jobs/${encodeURIComponent(button.dataset.cancelSap)}/cancel`,{method:'POST'});toast('Cancelamento solicitado.');ensureSapPolling();await loadJobs()}catch(error){button.disabled=false;toast(error.message)}};
document.getElementById('cancel-active-jobs').onclick=async()=>{const button=document.getElementById('cancel-active-jobs');button.disabled=true;try{const result=await api('/api/sap/jobs/cancel-active',{method:'POST'});toast(result.count?`${result.count} execução(ões) em cancelamento.`:'Não há execução ativa.');ensureSapPolling();await loadJobs()}catch(error){toast(error.message)}finally{button.disabled=false}};
let mappingsLoaded=false;
function mappingCard(payload){const g=payload.group,headers=g.columns,rows=payload.rows;return `<article class="card mapping-card" data-mapping-group="${esc(g.key)}"><div class="head"><div><h2>${esc(g.title)}</h2><span class="mapping-source">Origem: ${esc(g.source)} · ${rows.length} regras</span></div></div><div class="mapping-scroll"><table class="mapping-table"><thead><tr><th>${esc(headers[0])}</th><th>${esc(headers[1])}</th><th>${esc(headers[2])}</th><th>Ações</th></tr></thead><tbody>${rows.map(row=>`<tr data-mapping-id="${row.mapping_id}"><td><input data-field="key_value" value="${esc(row.key_value)}"></td><td><input data-field="value_1" value="${esc(row.value_1||'')}"></td><td><input data-field="value_2" value="${esc(row.value_2||'')}"></td><td><div class="mapping-actions"><button class="btn mapping-save" type="button">Salvar</button><button class="btn danger mapping-delete" type="button">Excluir</button></div></td></tr>`).join('')}</tbody></table></div><form class="mapping-add" data-group="${esc(g.key)}"><input name="key_value" placeholder="${esc(headers[0])}" required><input name="value_1" placeholder="${esc(headers[1])}"><input name="value_2" placeholder="${esc(headers[2])}"><button class="btn primary" type="submit">Adicionar</button></form></article>`}
async function loadMappings(force=false){if(mappingsLoaded&&!force)return;const editor=document.getElementById('mapping-editor'),status=document.getElementById('mapping-status');editor.innerHTML='<div class="card section loading">Carregando regras auxiliares…</div>';try{const groups=await api('/api/mappings'),payloads=await Promise.all(groups.map(group=>api(`/api/mappings/${group.key}`)));editor.innerHTML=payloads.map(mappingCard).join('');status.textContent=`${groups.reduce((sum,g)=>sum+g.rows,0)} regras ativas`;mappingsLoaded=true}catch(e){editor.innerHTML=`<div class="card section">${esc(e.message)}</div>`;status.textContent='Falha ao carregar';toast(e.message)}}
function mappingRefreshMessage(result,action){const info=result?.recalculated||{};return `${action} e aplicada a ${num.format(info.period_count||0)} competência(s) / ${num.format(info.row_count||0)} linha(s)`}
document.getElementById('mapping-editor').addEventListener('click',async event=>{const row=event.target.closest('tr[data-mapping-id]'),card=event.target.closest('[data-mapping-group]');if(!row||!card)return;const group=card.dataset.mappingGroup,id=row.dataset.mappingId;if(event.target.closest('.mapping-save')){const body=Object.fromEntries([...row.querySelectorAll('input[data-field]')].map(input=>[input.dataset.field,input.value||null]));try{const result=await api(`/api/mappings/${group}/${id}`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});toast(mappingRefreshMessage(result,'Regra salva'));state.loadedViews.clear();mappingsLoaded=false;await loadMappings()}catch(e){toast(e.message)}}if(event.target.closest('.mapping-delete')){try{const result=await api(`/api/mappings/${group}/${id}`,{method:'DELETE'});toast(mappingRefreshMessage(result,'Regra excluída'));state.loadedViews.clear();mappingsLoaded=false;await loadMappings()}catch(e){toast(e.message)}}});
document.getElementById('mapping-editor').addEventListener('submit',async event=>{const form=event.target.closest('.mapping-add');if(!form)return;event.preventDefault();const body=Object.fromEntries(new FormData(form));Object.keys(body).forEach(key=>{if(body[key]==='')body[key]=null});try{const result=await api(`/api/mappings/${form.dataset.group}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});toast(mappingRefreshMessage(result,'Nova regra adicionada'));state.loadedViews.clear();mappingsLoaded=false;await loadMappings()}catch(e){toast(e.message)}});
function syncPeriodControls(){document.querySelectorAll('input[name=period]').forEach(x=>x.value=state.period);const [year,month]=state.period.split('-').map(Number),last=String(new Date(year,month,0).getDate()).padStart(2,'0'),mm=String(month).padStart(2,'0');const z=document.getElementById('z-form'),m=document.getElementById('m-form');if(z?.elements?.as_of)z.elements.as_of.value=`${year}-${mm}-${last}`;if(m?.elements?.date_from)m.elements.date_from.value=`${year}-${mm}-01`;if(m?.elements?.date_to)m.elements.date_to.value=`${year}-${mm}-${last}`}
async function loadConfig(){const [c,p]=await Promise.all([api('/api/config'),api('/api/inventory/periods')]);state.periods=p.periods||[];const select=document.getElementById('global-period');select.innerHTML=state.periods.length?state.periods.map(item=>`<option value="${esc(item.period)}">${esc(item.label)}</option>`).join(''):'<option value="">Nenhuma competência compilada</option>';const requested=c.default_period,available=state.periods.some(item=>item.period===requested);state.period=available?requested:(p.default_period||state.periods[0]?.period||'');select.value=state.period;syncPeriodControls();if(c.sap_connection_name)document.querySelectorAll('input[name=connection_name]').forEach(x=>x.value=c.sap_connection_name);const frame=document.createElement('iframe');frame.src='/optimus';frame.title='Optimus - Agente contábil';frame.referrerPolicy='same-origin';document.getElementById('agent-container').replaceChildren(frame);document.getElementById('agent-status').textContent='Optimus carregado';document.getElementById('agent-status').classList.remove('warn')}

function applyPreferences(p){document.body.classList.toggle('comfortable',p.density==='comfortable');document.body.classList.toggle('no-motion',p.animations_enabled===false);state.pageSize=Number(p.default_page_size||50);document.getElementById('page-size').value=String(state.pageSize)}
function renderCompiledPeriods(periods=[]){const list=document.getElementById('period-delete-list');list.innerHTML=periods.length?periods.map(item=>{const label=String(item.period).replace(/^(\d{4})-(\d{2})$/,'$2/$1');return `<div class="period-delete-item"><div><b>${esc(label)}</b><small>${esc(item.period)}</small></div><button class="btn danger" type="button" data-delete-period="${esc(item.period)}">Excluir</button></div>`}).join(''):'<div class="period-delete-empty">Nenhuma competência compilada.</div>';list.querySelectorAll('[data-delete-period]').forEach(button=>button.onclick=()=>openPeriodDelete(button.dataset.deletePeriod))}
function renderSettings(data){
  const p=data.preferences,ui=document.getElementById('ui-settings-form'),backup=document.getElementById('backup-settings-form');
  ui.elements.density.value=p.density;ui.elements.default_page_size.value=String(p.default_page_size);ui.elements.animations_enabled.checked=Boolean(p.animations_enabled);backup.elements.backup_folder.value=p.backup_folder;backup.elements.backup_frequency.value=p.backup_frequency;backup.elements.backup_retention_days.value=p.backup_retention_days;applyPreferences(p);
  state.pageCatalog=data.page_catalog;const pageLabels=Object.fromEntries(data.page_catalog.map(page=>[page.key,page.label])),pagesBox=document.getElementById('access-pages');pagesBox.innerHTML=data.page_catalog.map(page=>`<label class="${page.key==='overview'?'required':''}"><input type="checkbox" name="access_page" value="${esc(page.key)}"> ${esc(page.label)}${page.key==='overview'?' · obrigatória':''}</label>`).join('');toggleAccessPages();renderCompiledPeriods(data.compiled_periods||[]);
  document.getElementById('settings-status').textContent='Acesso protegido';document.getElementById('settings-status').classList.remove('warn');
  document.getElementById('access-mode').textContent=`O e-mail, a identidade corporativa do Windows e as permissões por página são validados no servidor. Identidade desta máquina: ${data.detected_corporate_email||'não identificada'}.`;
  document.getElementById('access-list').innerHTML=data.allowed_users.length?data.allowed_users.map(u=>{const pageText=u.role==='admin'?'Todas as páginas':u.pages.map(page=>pageLabels[page]||page).join(' · '),deleteProtected=u.bootstrap_admin||u.email===state.authUser?.email,deleteButton=deleteProtected?`<button class="btn danger" type="button" disabled title="Administrador inicial ou sessão atual protegida">Excluir</button>`:`<button class="btn danger" type="button" data-delete-user="${esc(u.email)}">Excluir</button>`;return `<div class="access-user"><div><b>${esc(u.email)}</b><small>${u.role==='admin'?'Administrador':'Usuário'} · ${esc(pageText||'Sem páginas')} · ${u.identity_verified?'Identidade vinculada':'Primeiro acesso pendente'}</small></div><span class="badge ${u.is_active?'':'warn'}">${u.is_active?'Ativo':'Inativo'}</span><div class="access-user-actions"><button class="btn" data-edit-user="${esc(u.email)}">Editar</button>${deleteButton}${u.is_active&&!u.bootstrap_admin?`<button class="btn" data-disable-user="${esc(u.email)}">Desativar</button>`:''}</div></div>`}).join(''):'<div class="sub">Nenhum e-mail cadastrado.</div>';
  document.querySelectorAll('[data-edit-user]').forEach(button=>button.onclick=()=>{const user=data.allowed_users.find(item=>item.email===button.dataset.editUser);document.getElementById('access-email').value=user.email;document.getElementById('access-role').value=user.role;pagesBox.querySelectorAll('input').forEach(input=>input.checked=user.pages.includes(input.value));toggleAccessPages();document.getElementById('access-email').focus()});
  document.querySelectorAll('[data-delete-user]').forEach(button=>button.onclick=()=>openAccessDelete(button.dataset.deleteUser));
  document.querySelectorAll('[data-disable-user]').forEach(button=>button.onclick=async()=>{try{const next=await api(`/api/settings/access/${encodeURIComponent(button.dataset.disableUser)}/disable`,{method:'POST'});renderSettings(next);toast('Acesso desativado')}catch(e){toast(e.message)}});
}
function toggleAccessPages(){const pages=document.getElementById('access-pages'),isAdmin=document.getElementById('access-role').value==='admin';pages.hidden=isAdmin;const overview=pages.querySelector('input[value="overview"]');if(overview){overview.checked=true;overview.disabled=!isAdmin}}
document.getElementById('access-role').onchange=toggleAccessPages;
const accessDeleteDialog=document.getElementById('access-delete-dialog');let pendingDeleteUser='';
function openAccessDelete(email){pendingDeleteUser=email;document.getElementById('access-delete-message').textContent=`Excluir definitivamente o acesso de ${email}?`;document.getElementById('access-delete-error').textContent='';accessDeleteDialog.showModal()}
document.getElementById('access-delete-cancel').onclick=()=>accessDeleteDialog.close();
document.getElementById('access-delete-submit').onclick=async()=>{if(!pendingDeleteUser)return;const submit=document.getElementById('access-delete-submit'),error=document.getElementById('access-delete-error');submit.disabled=true;error.textContent='';try{const next=await api(`/api/settings/access/${encodeURIComponent(pendingDeleteUser)}`,{method:'DELETE'});accessDeleteDialog.close();renderSettings(next);toast(`Acesso de ${pendingDeleteUser} excluído`);pendingDeleteUser=''}catch(e){error.textContent=e.message}finally{submit.disabled=false}};
const periodDeleteDialog=document.getElementById('period-delete-dialog'),periodDeleteForm=document.getElementById('period-delete-form');let pendingDeletePeriod='';
function openPeriodDelete(period){pendingDeletePeriod=period;document.getElementById('period-delete-message').textContent=`Esta ação removerá os dados compilados de ${period} e criará um backup local antes da exclusão.`;document.getElementById('period-delete-label').textContent=`Digite ${period} para confirmar`;document.getElementById('period-delete-confirm').value='';document.getElementById('period-delete-error').textContent='';periodDeleteDialog.showModal();setTimeout(()=>document.getElementById('period-delete-confirm').focus(),50)}
document.getElementById('period-delete-cancel').onclick=()=>periodDeleteDialog.close();
periodDeleteForm.onsubmit=async event=>{event.preventDefault();const confirmation=document.getElementById('period-delete-confirm').value.trim(),error=document.getElementById('period-delete-error'),submit=document.getElementById('period-delete-submit');if(confirmation!==pendingDeletePeriod){error.textContent=`Digite exatamente ${pendingDeletePeriod}.`;return}submit.disabled=true;error.textContent='';try{const result=await api(`/api/settings/periods/${encodeURIComponent(pendingDeletePeriod)}`,{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({confirmation})});periodDeleteDialog.close();renderSettings(result.settings);state.loadedViews.clear();await loadConfig();const active=document.querySelector('[data-panel].active')?.dataset.panel||'overview';if(active!=='settings')await loadViewData(active,{force:true});toast(`Competência ${result.deletion.period} excluída. Backup de recuperação criado.`)}catch(e){error.textContent=e.message}finally{submit.disabled=false}};
async function loadInstallerStatus(){const meta=document.getElementById('installer-meta'),download=document.getElementById('installer-download'),note=document.getElementById('installer-note');try{const env=await api('/api/settings/environment');if(!env.installer_available){meta.textContent='Instalador ainda não publicado.';download.classList.add('disabled');download.removeAttribute('href');return}const mb=(Number(env.installer_size_bytes||0)/1048576).toLocaleString('pt-BR',{maximumFractionDigits:1});const snapshot=env.installer_snapshot||{};const periods=Array.isArray(snapshot.periods)?snapshot.periods:[];const rows=periods.reduce((total,item)=>total+Number(item.rows||0),0);const labels=periods.map(item=>String(item.period||'').replace(/^(\d{4})-(\d{2})$/,'$2/$1')).filter(Boolean);meta.textContent=`Versão ${env.installer_version} · ${mb} MB · SHA-256 ${String(env.installer_sha256||'').slice(0,12)}…`;const dataText=labels.length?` Inclui ${labels.join(' e ')} (${rows.toLocaleString('pt-BR')} linhas compiladas), disponíveis já no primeiro acesso.`:'';note.textContent=`Arquivo publicado e validado (${env.installer_source==='project'?'fonte central do projeto':'cópia local de contingência'}).${dataText} Em uma atualização, o banco local existente permanece intacto.`;download.href='/api/installer/download';download.classList.remove('disabled')}catch(e){meta.textContent='Não foi possível validar o instalador.';download.classList.add('disabled');download.removeAttribute('href')}}
async function loadSettings(force=false){if(state.settingsLoaded&&!force)return;try{const [data]=await Promise.all([api('/api/settings'),loadInstallerStatus()]);state.settingsLoaded=true;renderSettings(data)}catch(e){document.getElementById('settings-status').textContent='Erro';toast(e.message)}}
document.getElementById('save-settings').onclick=async()=>{const ui=document.getElementById('ui-settings-form'),backup=document.getElementById('backup-settings-form');const payload={density:ui.elements.density.value,default_page_size:Number(ui.elements.default_page_size.value),animations_enabled:ui.elements.animations_enabled.checked,backup_folder:backup.elements.backup_folder.value,backup_frequency:backup.elements.backup_frequency.value,backup_retention_days:Number(backup.elements.backup_retention_days.value)};try{const data=await api('/api/settings',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});renderSettings(data);toast('Configurações salvas')}catch(e){toast(e.message)}};
document.getElementById('access-form').onsubmit=async event=>{event.preventDefault();const input=document.getElementById('access-email'),role=document.getElementById('access-role').value,pages=[...document.querySelectorAll('#access-pages input:checked')].map(item=>item.value);try{const data=await api('/api/settings/access',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:input.value,role,pages})});input.value='';document.getElementById('access-role').value='user';document.querySelectorAll('#access-pages input').forEach(item=>item.checked=false);renderSettings(data);toast('Acesso e permissões salvos')}catch(e){toast(e.message)}};

document.getElementById('global-period').onchange=async e=>{state.period=e.target.value;state.page=1;syncPeriodControls();document.getElementById('data-status').textContent='Atualizando '+state.period;await preloadSystem({force:true,text:`Carregando competência ${state.period}…`})};document.getElementById('refresh').onclick=async()=>{const active=document.querySelector('[data-panel].active')?.dataset.panel||firstAllowedView();state.loadedViews.delete(viewCacheKey(active));await loadViewData(active,{force:true});toast('Dados atualizados')};
const loaderPie=document.getElementById('loader-pie'),loaderPercent=document.getElementById('loader-percent'),loaderText=document.getElementById('loader-text'),loader=document.getElementById('system-loader');let loadingProgress=0;
function setLoadingProgress(value,text='Loading system...'){loadingProgress=Math.max(loadingProgress,Math.min(100,value));loaderPie.style.setProperty('--progress',loadingProgress+'%');loaderPercent.textContent=Math.round(loadingProgress)+'%';loaderText.textContent=text}
function resetSystemLoader(text='Loading system...'){loadingProgress=0;loaderPie.style.setProperty('--progress','0%');loaderPercent.textContent='0%';loaderText.textContent=text;loader.classList.remove('hidden')}
async function preloadSystem({force=false,text='Loading system...'}={}){resetSystemLoader(text);const views=['overview','inventory','all-brazil','mapping','governance','health','settings','sap','agent'].filter(canAccess),total=Math.max(1,views.length);let done=0;const timer=setInterval(()=>{const target=Math.min(88,10+(done/total)*78);if(loadingProgress<target)setLoadingProgress(loadingProgress+Math.max(1,(target-loadingProgress)*.18),text)},100);try{await Promise.all(views.map(async view=>{await loadViewData(view,{force,preload:true});done++;setLoadingProgress(10+(done/total)*84,text)}));setLoadingProgress(100,'System ready!');setTimeout(()=>loader.classList.add('hidden'),650)}finally{clearInterval(timer)}}
let systemStarted=false;
async function startSystem(){if(systemStarted)return;systemStarted=true;resetSystemLoader();try{setLoadingProgress(7);await loadConfig();setLoadingProgress(14);activate(location.hash.slice(1)||firstAllowedView(),false,false);await preloadSystem();}catch(e){toast(e.message);setLoadingProgress(100,'System ready!');setTimeout(()=>loader.classList.add('hidden'),900)}}
async function bootstrapAuth(){try{const response=await fetch('/api/auth/session',{credentials:'same-origin'}),session=await response.json();state.csrfToken=session.csrf_token||'';if(session.authenticated&&session.user){applyUserAccess(session.user);document.body.classList.add('authenticated');await startSystem()}}catch(e){setLoginMessage('Não foi possível validar o acesso ao sistema. Verifique se o serviço local está ativo.')}}
bootstrapAuth();
</script>
