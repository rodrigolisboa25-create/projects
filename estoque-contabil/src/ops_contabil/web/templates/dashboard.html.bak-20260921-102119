<script>
const state={period:'2026-07',page:1,pageSize:50,q:'',sort:'source_row',direction:'asc',columns:[],pages:1,filters:{},collapsed:new Set(),settingsLoaded:false,authUser:null,csrfToken:''};
const labels={overview:'Visão e relatórios',inventory:'Base de estoque',sap:'Extrações SAP','all-brazil':'Bases All Brazil',mapping:'Mapping',governance:'Controles e auditoria',agent:'Agente contábil',settings:'Configurações'};
const money=new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL',maximumFractionDigits:2}),num=new Intl.NumberFormat('pt-BR',{maximumFractionDigits:2});
const detailGroups=[
  {label:'IDENTIFICAÇÃO',band:'identification',tone:'identification',keys:['center_material_key','operation_status']},
  {label:'SAP ZMM119',band:'sap',tone:'sap',keys:['company','plant','material','material_description','base_unit','ncm','unrestricted_quantity','blocked_quantity','average_company_cost','fiscal_cost','total','icms_st_amount','ipi_amount','inventory_type','company_total_amount','fiscal_total_amount','average_commercial_cost','commercial_total_amount']},
  {label:'FÓRMULA',band:'enrichment',tone:'formula',keys:['company_unit_cost','style_color','style','fiscal_unit_cost']},
