async function loadAllBrazilCatalog(force=false){
  if(allBrazilCatalogLoaded&&!force)return;
  const container=document.getElementById('all-brazil-catalog'),status=document.getElementById('all-brazil-catalog-status');
  container.innerHTML='<div class="loading">Localizando anos, meses e snapshots disponíveis…</div>';status.textContent='Mapeando Drive';
  try{
    const catalog=await api('/api/sources/all-brazil/catalog');allBrazilCatalogLoaded=true;document.getElementById('all-brazil-root').textContent=catalog.root;
    const monthCount=catalog.years.reduce((total,year)=>total+year.months.length,0);status.textContent=`${catalog.years.length} anos · ${monthCount} meses`;
    container.innerHTML=catalog.years.length?catalog.years.map(year=>`<section class="drive-year"><div class="drive-year-title"><h3>${year.year}</h3><span>${year.months.length} meses disponíveis</span></div><div class="drive-months">${year.months.map(month=>{const shown=month.files.slice(0,5),remaining=Math.max(0,month.files.length-shown.length);return `<article class="drive-month"><div class="drive-month-head"><h4>${esc(month.label)}</h4><a class="btn" href="${esc(month.drive_url||catalog.root_url)}" target="_blank" rel="noopener noreferrer">Abrir no Drive</a></div>${shown.length?`<div class="drive-files">${shown.map(file=>`<div class="drive-file"><span title="${esc(file.name)}">${esc(file.name)}</span><b>${esc(file.snapshot_date||'')}</b></div>`).join('')}${remaining?`<div class="drive-empty">+ ${remaining} arquivo(s) no mês</div>`:''}</div>`:'<div class="drive-empty">Pasta disponível no Google Drive.</div>'}</article>`}).join('')}</div></section>`).join(''):'<div class="drive-empty">Nenhuma pasta anual/mensal foi localizada no catálogo do Google Drive.</div>';
  }catch(e){status.textContent='Drive indisponível';container.innerHTML=`<div class="drive-empty">${esc(e.message)}</div>`;toast(e.message)}
}
document.getElementById('reload-all-brazil').onclick=()=>{allBrazilCatalogLoaded=false;loadAllBrazilCatalog(true)};
function formatCell(value,type){if(value==null||value==='')return '';if(type==='integer')return String(Math.trunc(Number(value)));if(type==='number')return num.format(value);if(type==='date'){const p=String(value).slice(0,10).split('-');return p.length===3?`${p[2]}/${p[1]}/${p[0]}`:value}return value}
function renderInventoryHeaders(){
  const groups=detailGroups.map(group=>`<th data-band="${group.band}" data-tone="${group.tone}" colspan="${group.keys.length}">${group.label}</th>`).join('');
  document.getElementById('inventory-groups').innerHTML='<th class="rownum">GRUPOS</th>'+groups;
  const arrow=key=>state.sort===key?(state.direction==='asc'?' ▲':' ▼'):'';
  document.getElementById('inventory-head').innerHTML=`<th class="rownum sortable" data-sort="source_row" title="Ordenar pelo número da linha">#${arrow('source_row')}</th>`+state.columns.map(c=>`<th data-band="${keyBand.get(c.key)}" data-tone="${keyTone.get(c.key)}" data-sort="${c.key}" title="Ordenar por ${esc(c.label)}">${esc(c.label)}${arrow(c.key)}</th>`).join('');
  document.getElementById('inventory-filters').innerHTML='<th class="rownum"></th>'+state.columns.map(c=>`<th data-band="${keyBand.get(c.key)}"><input class="column-filter" data-filter="${c.key}" value="${esc(state.filters[c.key]||'')}" aria-label="Filtrar ${esc(c.label)}" placeholder="Filtrar"></th>`).join('');
  document.querySelectorAll('#inventory-head [data-sort]').forEach(th=>th.onclick=()=>{const key=th.dataset.sort;state.direction=state.sort===key&&state.direction==='asc'?'desc':'asc';state.sort=key;loadInventory()});
  document.querySelectorAll('.column-filter').forEach(input=>input.oninput=()=>{clearTimeout(input._timer);input._timer=setTimeout(()=>{if(input.value.trim())state.filters[input.dataset.filter]=input.value.trim();else delete state.filters[input.dataset.filter];state.page=1;loadInventory()},450)});
}
async function loadInventory(){
  try{
    if(!state.columns.length)state.columns=await api('/api/inventory/columns');
    renderInventoryHeaders();
    const params=new URLSearchParams({period:state.period,page:state.page,page_size:state.pageSize,q:state.q,sort:state.sort,direction:state.direction,filters:JSON.stringify(state.filters)});
    const d=await api('/api/inventory?'+params);state.pages=d.pages;
    document.getElementById('inventory-body').innerHTML=d.rows.length?d.rows.map(r=>'<tr><td class="rownum">'+r.source_row+'</td>'+state.columns.map(c=>`<td data-band="${keyBand.get(c.key)}" class="${c.type==='number'?'number':''}" title="${esc(formatCell(r[c.key],c.type))}">${esc(formatCell(r[c.key],c.type))}</td>`).join('')+'</tr>').join(''):`<tr><td colspan="${state.columns.length+1}">Nenhum registro encontrado.</td></tr>`;
    document.getElementById('grid-count').textContent=num.format(d.total)+' linhas';document.getElementById('grid-info').textContent=`Página ${d.page} de ${d.pages} · ${num.format(d.total)} registros`;document.getElementById('prev-page').disabled=d.page<=1;document.getElementById('next-page').disabled=d.page>=d.pages;
  }catch(e){document.getElementById('inventory-body').innerHTML=`<tr><td>${esc(e.message)}</td></tr>`;toast(e.message)}
}
async function loadMb59Status(){const el=document.getElementById('mb59-inventory-status');try{const status=await api(`/api/sources/mb59/status?period=${state.period}`);el.textContent=status.updated?`MB59 atualizada · ${num.format(status.lookup_rows)} chaves`:'MB59 pendente';el.title=status.updated?`${status.file_name} · importada em ${status.imported_at}`:'A ZMM119 pode ser executada. O PASSO A PASSO usará a posição anterior e o All Brazil enquanto a MB59 estiver pendente.';el.classList.toggle('mb59-ready',status.updated);el.classList.toggle('mb59-pending',!status.updated)}catch(e){el.textContent='MB59: status indisponível';el.title=e.message;el.classList.add('mb59-pending')}}
document.querySelectorAll('[data-toggle-band]').forEach(button=>button.onclick=()=>{const band=button.dataset.toggleBand;if(state.collapsed.has(band))state.collapsed.delete(band);else state.collapsed.add(band);button.setAttribute('aria-pressed',String(!state.collapsed.has(band)));document.getElementById('inventory-table').classList.toggle('hide-'+band,state.collapsed.has(band))});
document.getElementById('clear-column-filters').onclick=()=>{state.filters={};state.page=1;loadInventory()};
document.getElementById('search-btn').onclick=()=>{state.q=document.getElementById('grid-search').value;state.page=1;loadInventory()};document.getElementById('grid-search').onkeydown=e=>{if(e.key==='Enter')document.getElementById('search-btn').click()};document.getElementById('page-size').onchange=e=>{state.pageSize=+e.target.value;state.page=1;loadInventory()};document.getElementById('prev-page').onclick=()=>{if(state.page>1){state.page--;loadInventory()}};document.getElementById('next-page').onclick=()=>{if(state.page<state.pages){state.page++;loadInventory()}};
document.getElementById('reload-grid').onclick=async()=>{toast('Lendo a Base Orig. pelo Excel; aguarde…');try{const r=await api('/api/inventory/import',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({period:state.period,force:true})});toast(`${r.rows} linhas atualizadas`);loadSummary();loadInventory()}catch(e){toast(e.message)}};

let sapPollTimer=null;
function ensureSapPolling(){if(sapPollTimer)return;sapPollTimer=setInterval(async()=>{const jobs=await loadJobs();const active=jobs.some(job=>['QUEUED','STARTING','CONNECTION_SELECTED','OPENING_SAP','OPENING_CONNECTION','WAITING_FOR_LOGIN','RUNNING','OPENING_TRANSACTION','RUNNING_REPORT','ARCHIVING','EXPORTING','EXPORTING_FILE','FILE_READY','IMPORTING','ENRICHING'].includes(job.status));if(!active){clearInterval(sapPollTimer);sapPollTimer=null}},1000)}
async function submitSap(form,transaction){const data=Object.fromEntries(new FormData(form));const body={transaction,period:data.period,connection_name:data.connection_name||'',variant:data.variant||'BASE GR',date_from:data.date_from||null,date_to:data.date_to||null,as_of:data.as_of||null,fisia_only:data.fisia_only==='on'};try{await api('/api/sap/run',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});toast(`${transaction}: abrindo SAP e preparando a extração`);await loadJobs();ensureSapPolling()}catch(e){toast(e.message)}}
document.getElementById('z-form').onsubmit=e=>{e.preventDefault();submitSap(e.target,'ZMM119')};document.getElementById('m-form').onsubmit=e=>{e.preventDefault();submitSap(e.target,'MB59')};
async function loadJobs(){try{const jobs=await api('/api/sap/jobs'),names={QUEUED:'Na fila',STARTING:'Preparando',CONNECTION_SELECTED:'Conexão localizada',OPENING_SAP:'Abrindo SAP',OPENING_CONNECTION:'Abrindo conexão',WAITING_FOR_LOGIN:'Aguardando login',RUNNING:'Executando',OPENING_TRANSACTION:'Abrindo transação',RUNNING_REPORT:'Processando relatório',ARCHIVING:'Preservando anterior',EXPORTING:'Enviando comandos',EXPORTING_FILE:'Gerando XLSX',FILE_READY:'Arquivo localizado',IMPORTING:'Importando base',ENRICHING:'Aplicando All Brazil',COMPLETED:'Concluído',ACTION_REQUIRED:'Requer ação',FAILED:'Falhou'},container=document.getElementById('jobs-list');if(!jobs.length){container.innerHTML='<div class="sap-empty">Nenhuma extração em andamento nesta sessão.</div>';return []}const j=jobs[0],active=!['COMPLETED','FAILED','ACTION_REQUIRED'].includes(j.status),started=j.started_at?new Date(j.started_at).getTime():Date.now(),elapsed=Math.max(0,(Date.now()-started)/1000);let progress=Number(j.progress||0);if(active&&j.status==='EXPORTING_FILE')progress=Math.min(85,progress+Math.floor(elapsed/8));progress=Math.max(0,Math.min(100,progress));const stateClass=j.status==='COMPLETED'?'completed':j.status==='FAILED'?'failed':'';container.innerHTML=`<div class="sap-monitor ${stateClass}"><div class="sap-monitor-top"><div class="sap-ticker"><span class="live-dot"></span><b>${esc(j.transaction)}</b><span>${esc(j.period)}</span></div><span class="sap-percent">${progress}%</span></div><div class="sap-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${progress}" aria-label="Andamento estimado da extração"><div class="sap-progress-fill" style="width:${progress}%"></div></div><div class="sap-job-meta"><span class="badge ${['FAILED','ACTION_REQUIRED','WAITING_FOR_LOGIN'].includes(j.status)?'warn':''}">${esc(names[j.status]||j.status)}</span><span class="sap-message">${esc(j.message||'Preparando a execução no SAP GUI')}</span><span class="sap-clock">${j.duration_seconds!=null?esc(j.duration_seconds+' s'):esc(j.created_at||'')}</span></div></div>`;return jobs}catch(e){toast(e.message);return []}}document.getElementById('refresh-jobs').onclick=loadJobs;
let mappingsLoaded=false;
function mappingCard(payload){const g=payload.group,headers=g.columns,rows=payload.rows;return `<article class="card mapping-card" data-mapping-group="${esc(g.key)}"><div class="head"><div><h2>${esc(g.title)}</h2><span class="mapping-source">Origem: ${esc(g.source)} · ${rows.length} regras</span></div></div><div class="mapping-scroll"><table class="mapping-table"><thead><tr><th>${esc(headers[0])}</th><th>${esc(headers[1])}</th><th>${esc(headers[2])}</th><th>Ações</th></tr></thead><tbody>${rows.map(row=>`<tr data-mapping-id="${row.mapping_id}"><td><input data-field="key_value" value="${esc(row.key_value)}"></td><td><input data-field="value_1" value="${esc(row.value_1||'')}"></td><td><input data-field="value_2" value="${esc(row.value_2||'')}"></td><td><div class="mapping-actions"><button class="btn mapping-save" type="button">Salvar</button><button class="btn danger mapping-delete" type="button">Excluir</button></div></td></tr>`).join('')}</tbody></table></div><form class="mapping-add" data-group="${esc(g.key)}"><input name="key_value" placeholder="${esc(headers[0])}" required><input name="value_1" placeholder="${esc(headers[1])}"><input name="value_2" placeholder="${esc(headers[2])}"><button class="btn primary" type="submit">Adicionar</button></form></article>`}
async function loadMappings(force=false){if(mappingsLoaded&&!force)return;const editor=document.getElementById('mapping-editor'),status=document.getElementById('mapping-status');editor.innerHTML='<div class="card section loading">Carregando regras auxiliares…</div>';try{const groups=await api('/api/mappings'),payloads=await Promise.all(groups.map(group=>api(`/api/mappings/${group.key}`)));editor.innerHTML=payloads.map(mappingCard).join('');status.textContent=`${groups.reduce((sum,g)=>sum+g.rows,0)} regras ativas`;mappingsLoaded=true}catch(e){editor.innerHTML=`<div class="card section">${esc(e.message)}</div>`;status.textContent='Falha ao carregar';toast(e.message)}}
document.getElementById('mapping-editor').addEventListener('click',async event=>{const row=event.target.closest('tr[data-mapping-id]'),card=event.target.closest('[data-mapping-group]');if(!row||!card)return;const group=card.dataset.mappingGroup,id=row.dataset.mappingId;if(event.target.closest('.mapping-save')){const body=Object.fromEntries([...row.querySelectorAll('input[data-field]')].map(input=>[input.dataset.field,input.value||null]));try{await api(`/api/mappings/${group}/${id}`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});toast('Regra salva e aplicada à base');mappingsLoaded=false;await loadMappings()}catch(e){toast(e.message)}}if(event.target.closest('.mapping-delete')){try{await api(`/api/mappings/${group}/${id}`,{method:'DELETE'});toast('Regra excluída');mappingsLoaded=false;await loadMappings()}catch(e){toast(e.message)}}});
document.getElementById('mapping-editor').addEventListener('submit',async event=>{const form=event.target.closest('.mapping-add');if(!form)return;event.preventDefault();const body=Object.fromEntries(new FormData(form));Object.keys(body).forEach(key=>{if(body[key]==='')body[key]=null});try{await api(`/api/mappings/${form.dataset.group}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});toast('Nova regra adicionada');mappingsLoaded=false;await loadMappings()}catch(e){toast(e.message)}});
async function loadConfig(){const c=await api('/api/config');if(c.default_period){state.period=c.default_period;document.getElementById('global-period').value=state.period;document.querySelectorAll('input[name=period]').forEach(x=>x.value=state.period)}if(c.sap_connection_name)document.querySelectorAll('input[name=connection_name]').forEach(x=>x.value=c.sap_connection_name);const frame=document.createElement('iframe');frame.src='/optimus';frame.title='Agente contábil Optimus';frame.referrerPolicy='same-origin';document.getElementById('agent-container').replaceChildren(frame);document.getElementById('agent-status').textContent='Optimus carregado';document.getElementById('agent-status').classList.remove('warn')}

function applyPreferences(p){document.body.classList.toggle('comfortable',p.density==='comfortable');document.body.classList.toggle('no-motion',p.animations_enabled===false);state.pageSize=Number(p.default_page_size||50);document.getElementById('page-size').value=String(state.pageSize)}
function renderSettings(data){
  const p=data.preferences,ui=document.getElementById('ui-settings-form'),backup=document.getElementById('backup-settings-form');
  ui.elements.density.value=p.density;ui.elements.default_page_size.value=String(p.default_page_size);ui.elements.animations_enabled.checked=Boolean(p.animations_enabled);backup.elements.backup_folder.value=p.backup_folder;backup.elements.backup_frequency.value=p.backup_frequency;backup.elements.backup_retention_days.value=p.backup_retention_days;applyPreferences(p);
  state.pageCatalog=data.page_catalog;const pageLabels=Object.fromEntries(data.page_catalog.map(page=>[page.key,page.label])),pagesBox=document.getElementById('access-pages');pagesBox.innerHTML=data.page_catalog.map(page=>`<label><input type="checkbox" name="access_page" value="${esc(page.key)}"> ${esc(page.label)}</label>`).join('');toggleAccessPages();
  document.getElementById('settings-status').textContent='Acesso protegido';document.getElementById('settings-status').classList.remove('warn');
  document.getElementById('access-mode').textContent=`O e-mail, a identidade corporativa do Windows e as permissões por página são validados no servidor. Identidade desta máquina: ${data.detected_corporate_email||'não identificada'}.`;
  document.getElementById('access-list').innerHTML=data.allowed_users.length?data.allowed_users.map(u=>{const pageText=u.role==='admin'?'Todas as páginas':u.pages.map(page=>pageLabels[page]||page).join(' · ');return `<div class="access-user"><div><b>${esc(u.email)}</b><small>${u.role==='admin'?'Administrador':'Usuário'} · ${esc(pageText||'Sem páginas')} · ${u.identity_verified?'Identidade vinculada':'Primeiro acesso pendente'}</small></div><span class="badge ${u.is_active?'':'warn'}">${u.is_active?'Ativo':'Inativo'}</span><div class="access-user-actions"><button class="btn" data-edit-user="${esc(u.email)}">Editar</button>${u.is_active&&!u.bootstrap_admin?`<button class="btn danger" data-disable-user="${esc(u.email)}">Desativar</button>`:''}</div></div>`}).join(''):'<div class="sub">Nenhum e-mail cadastrado.</div>';
  document.querySelectorAll('[data-edit-user]').forEach(button=>button.onclick=()=>{const user=data.allowed_users.find(item=>item.email===button.dataset.editUser);document.getElementById('access-email').value=user.email;document.getElementById('access-role').value=user.role;pagesBox.querySelectorAll('input').forEach(input=>input.checked=user.pages.includes(input.value));toggleAccessPages();document.getElementById('access-email').focus()});
  document.querySelectorAll('[data-disable-user]').forEach(button=>button.onclick=async()=>{try{const next=await api(`/api/settings/access/${encodeURIComponent(button.dataset.disableUser)}/disable`,{method:'POST'});renderSettings(next);toast('Acesso desativado')}catch(e){toast(e.message)}});
}
function toggleAccessPages(){document.getElementById('access-pages').hidden=document.getElementById('access-role').value==='admin'}
document.getElementById('access-role').onchange=toggleAccessPages;
async function loadSettings(force=false){if(state.settingsLoaded&&!force)return;try{const data=await api('/api/settings');state.settingsLoaded=true;renderSettings(data)}catch(e){document.getElementById('settings-status').textContent='Erro';toast(e.message)}}
document.getElementById('save-settings').onclick=async()=>{const ui=document.getElementById('ui-settings-form'),backup=document.getElementById('backup-settings-form');const payload={density:ui.elements.density.value,default_page_size:Number(ui.elements.default_page_size.value),animations_enabled:ui.elements.animations_enabled.checked,backup_folder:backup.elements.backup_folder.value,backup_frequency:backup.elements.backup_frequency.value,backup_retention_days:Number(backup.elements.backup_retention_days.value)};try{const data=await api('/api/settings',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});renderSettings(data);toast('Configurações salvas')}catch(e){toast(e.message)}};
document.getElementById('access-form').onsubmit=async event=>{event.preventDefault();const input=document.getElementById('access-email'),role=document.getElementById('access-role').value,pages=[...document.querySelectorAll('#access-pages input:checked')].map(item=>item.value);try{const data=await api('/api/settings/access',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:input.value,role,pages})});input.value='';document.getElementById('access-role').value='user';document.querySelectorAll('#access-pages input').forEach(item=>item.checked=false);renderSettings(data);toast('Acesso e permissões salvos')}catch(e){toast(e.message)}};

document.getElementById('global-period').onchange=e=>{state.period=e.target.value;state.page=1;document.querySelectorAll('input[name=period]').forEach(x=>x.value=state.period);const active=document.querySelector('[data-panel].active')?.dataset.panel||firstAllowedView();loadViewData(active)};document.getElementById('refresh').onclick=()=>{const active=document.querySelector('[data-panel].active')?.dataset.panel||firstAllowedView();loadViewData(active);toast('Dados atualizados')};
const loaderPie=document.getElementById('loader-pie'),loaderPercent=document.getElementById('loader-percent'),loaderText=document.getElementById('loader-text'),loader=document.getElementById('system-loader');let loadingProgress=0;
function setLoadingProgress(value,text='Loading system...'){loadingProgress=Math.max(loadingProgress,Math.min(100,value));loaderPie.style.setProperty('--progress',loadingProgress+'%');loaderPercent.textContent=Math.round(loadingProgress)+'%';loaderText.textContent=text}
let systemStarted=false;
async function startSystem(){if(systemStarted)return;systemStarted=true;loader.classList.remove('hidden');loadingProgress=0;const timer=setInterval(()=>{if(loadingProgress<88)setLoadingProgress(loadingProgress+Math.max(1,(88-loadingProgress)*.08))},120);try{setLoadingProgress(8);await loadConfig();setLoadingProgress(32);const view=activate(location.hash.slice(1)||firstAllowedView(),false,false);await loadViewData(view);setLoadingProgress(100,'System ready!');setTimeout(()=>loader.classList.add('hidden'),700)}catch(e){toast(e.message);setLoadingProgress(100,'System ready!');setTimeout(()=>loader.classList.add('hidden'),900)}finally{clearInterval(timer)}}
async function bootstrapAuth(){try{const response=await fetch('/api/auth/session',{credentials:'same-origin'}),session=await response.json();state.csrfToken=session.csrf_token||'';if(session.authenticated&&session.user){applyUserAccess(session.user);document.body.classList.add('authenticated');await startSystem()}}catch(e){setLoginMessage('Não foi possível validar o acesso ao sistema. Verifique se o serviço local está ativo.')}}
bootstrapAuth();
</script>
</body></html>